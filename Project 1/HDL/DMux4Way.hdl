/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    Not (in=sel[1], out=n1);

    And (a=n1,     b=in, out=and1);
    And (a=sel[1], b=in, out=and2);

    DMux(in=and1, sel=sel[0], a=a, b=b);
    DMux(in=and2, sel=sel[0], a=c, b=d);
}
