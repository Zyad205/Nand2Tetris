/**
 * 16-bit multiplexor: 
 * for i = 0, ..., 15:
 * if (sel = 0) out[i] = a[i], else out[i] = b[i]
 */
CHIP Mux16 {
    IN a[16], b[16], sel;
    OUT out[16];

    PARTS:
    Fanner16Bus (in=sel, out=fn1);
    Not16       (in=fn1, out=n1);

    And16(a=n1,  b=a, out=and1);
    And16(a=fn1, b=b, out=and2);

    Or16 (a=and1, b=and2, out=out);
}
